# Existing backend/.env may already contain these. Never commit real values.
OPENAI_API_KEY=replace-with-provider-key
OPENAI_MODEL=gpt-4.1-mini
ODOO_RAG_DB_PASSWORD=replace-with-existing-db-password
ODOO_RAG_DB_HOST=127.0.0.1
ODOO_RAG_DB_PORT=55433
ODOO_RAG_DB_USER=odoo_rag
ODOO_RAG_DB_NAME=odoo_rag

# Put pilot-only settings in backend/.env.pilot without overwriting backend/.env.
# Generate a different random key per person: python -c 'import secrets; print(secrets.token_urlsafe(32))'
PILOT_ACCESS_KEYS={"operations":"replace-with-random-key-of-at-least-24-characters"}
PILOT_ADMIN_KEY=replace-with-distinct-random-operator-key
# Optional override of existing OPENAI_MODEL:
# PILOT_GENERATION_MODEL=gpt-4.1-mini
# Optional reasoning override for models that support it. Configured gpt-6-luna defaults to low.
# PILOT_REASONING_EFFORT=low
PILOT_PUBLIC_ORIGIN=http://localhost:8000
PILOT_SECURE_COOKIE=false
PILOT_ANSWERS_PER_DAY=100
PILOT_TOTAL_ANSWERS_PER_DAY=500
PILOT_REQUEST_TIMEOUT=60

# Optional: only after full-corpus indexing and explicit review.
# PILOT_RELEASE_FILE=/absolute/path/to/approved-release.json
# PILOT_BUDGET_FILE=/absolute/path/to/data/expansion/budget.sqlite3
# For isolated candidate review use localhost:8010 and a candidate descriptor:
# PILOT_CANDIDATE_PREVIEW=true
